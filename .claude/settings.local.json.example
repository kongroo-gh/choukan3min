// 無人の定期実行が承認待ちで止まらないための許可リスト。
// このファイルを .claude/settings.local.json にコピーして使う。
// settings.local.json 自体は gitignore されている（機械ごとの設定のため）。
//
// 注意: 手動実行で承認すると、その時の日付が焼き込まれた形で追記される。
//       例 Bash(python3 scripts/render.py post/2026-08-29)
//       翌日から一致しなくなるので、必ずワイルドカードに直すこと。
//
// WebFetch は列挙にしてある。無制限にすると無人のAIが任意のサイトを
// 読める状態になり、ページに書かれた内容に引きずられる危険がある。
// この一覧は NIGHTLY_TASK.md 内の一覧と必ず一致させること。
{
  "permissions": {
    "allow": [
      "Bash(TZ=Asia/Tokyo date *)",
      "Bash(mkdir -p post/*)",
      "Bash(python3 scripts/recent_topics.py *)",
      "Bash(python3 scripts/gemini_research.py *)",
      "Bash(source ~/.config/choukan3min.env && python3 scripts/gemini_research.py *)",
      "Bash(python3 scripts/render.py *)",
      "Bash(python3 scripts/validate.py *)",
      "Bash(python3 scripts/check_review.py *)",
      "Bash(python3 -c *)",
      "Bash(python3 - *)",
      "Bash(:)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)",
      "Bash(cat post/*)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(shasum *)",
      "Bash(find post/*)",
      "Write(post/**)",
      "Edit(post/**)",
      "Read(post/**)",
      "WebSearch",

      "WebFetch(domain:www.nikkei.com)",
      "WebFetch(domain:business.nikkei.com)",
      "WebFetch(domain:xtech.nikkei.com)",
      "WebFetch(domain:www.asahi.com)",
      "WebFetch(domain:mainichi.jp)",
